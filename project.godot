config_version=5

[application]

config/name="junior-astronaut-mission-trainer"
run/main_scene="res://ui/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.0862745, 0.0588235, 0.0470588, 1)
boot_splash/image="res://ui/splash.png"

[autoload]

Forge="*res://addons/forge/forge.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
display_server/driver.linuxbsd="wayland"

[physics]

common/max_physics_steps_per_frame=3
3d/physics_engine="Jolt Physics"
3d/default_gravity=3.73

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
